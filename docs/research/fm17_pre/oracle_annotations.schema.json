                    "string",
                    "null"
                  ]
                }
              }
            },
            "provenance": {
              "$ref": "#/$defs/evaluation_provenance"
            }
          }
        }
      }
    },
    "annotation_comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": [
            "LEXICAL_AMBIGUITY",
            "MULTIPLE_PLAUSIBLE_PARSE",
            "MISSING_EXPLICIT_SCOPE",
            "SOURCE_SPAN_DISAGREEMENT",
            "OTHER_NON_OUTCOME_REASON"
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 280
        }
      }
    }
  },
  "properties": {
    "pair_id": {
      "type": "string"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "fact_id": {
      "type": "string",
      "minLength": 1
    },
    "record_layer": {
      "type": "string",
      "enum": [
        "STRUCTURAL",
        "EVALUATION_OVERLAY"
      ]
    },
    "query": {
      "type": "object"
    },
    "fact": {
      "type": "object"
    },
    "annotation_comment": {
      "$ref": "#/$defs/annotation_comment"
    },
    "gold_relevance_class": {
      "type": "string",
      "enum": [
        "DIRECT",
        "COMPONENT",
        "RELATED",
        "NONANSWER"
      ],
      "description": "EVALUATION_OVERLAY only"
    },
    "hn_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "EVALUATION_OVERLAY only"
    },
    "diagnostic_subset": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "MULTIHOP_COMPONENT_RETENTION",
        "HN9_SCOPE",
        "NO_ANSWER",
        "SEMANTIC_DESIGN_LIMITATION",
        null
      ]
    },
    "evaluation_notes": {
      "type": "string",
      "description": "EVALUATION_OVERLAY only; never consumed by A1/A2"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_layer": {
            "const": "STRUCTURAL"
          }
        },
        "required": [
          "record_layer"
        ]
      },
      "then": {
        "properties": {
          "query": {
            "$ref": "#/$defs/structural_query"
          },
          "fact": {
            "$ref": "#/$defs/structural_fact"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "gold_relevance_class"
              ]
            },
            {
              "required": [
                "hn_labels"
              ]
            },
            {
              "required": [
                "evaluation_notes"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_layer": {
            "const": "EVALUATION_OVERLAY"
          }
        },
        "required": [
          "record_layer"
        ]
      },
      "then": {
        "properties": {
          "query": {
            "$ref": "#/$defs/evaluation_query"
          },
          "fact": {
            "$ref": "#/$defs/evaluation_fact"
          }
        }
      }
    }
  ]
}
