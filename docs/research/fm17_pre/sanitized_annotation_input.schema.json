{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fm17_pre_sanitized_annotation_input.schema.json",
  "title": "FM-17-pre Sanitized Annotation Input (annotator view)",
  "description": "Only raw texts + stable IDs. No gold, HN, CE, embedding, ranks, or arm outcomes. FORMAT ONLY \u2014 do not populate evaluation data in this repair.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "fact_id",
    "query_text",
    "fact_text"
  ],
  "properties": {
    "query_id": {
      "type": "string"
    },
    "fact_id": {
      "type": "string"
    },
    "query_text": {
      "type": "string"
    },
    "fact_text": {
      "type": "string"
    },
    "split": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CAL",
        "TEST",
        "DIAGNOSTIC",
        null
      ],
      "description": "Optional split tag without outcomes"
    }
  }
}
