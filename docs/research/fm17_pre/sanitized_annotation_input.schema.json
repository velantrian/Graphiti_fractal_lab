{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fm17_pre_sanitized_annotation_input.schema.json",
  "title": "FM-17-pre Sanitized Annotation Input v1.2",
  "description": "Annotator view. No CAL/TEST/HN/gold/score/rank. TEST_FIXTURE format only until execution is authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "fact_id",
    "query_text",
    "fact_text"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "fact_id": {
      "type": "string",
      "minLength": 1
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "fact_text": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "description": "Neutral operational batch id; MUST NOT encode CAL/TEST"
    }
  }
}
